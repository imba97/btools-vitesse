{
  "name": "btools-vitesse",
  "displayName": "Btools",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "逼砣，以B站为主增强网站功能，优化网站浏览体验。致力于简洁实用方便。",
  "scripts": {
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:prepare dev:background dev:web dev:js",
    "dev-firefox": "pnpm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:prepare dev:background dev:web dev:js",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "pnpm run build:background -- --mode development",
    "dev:web": "vite",
    "dev:js": "pnpm run build:js -- --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:background build:js",
    "build:prepare": "cross-env NODE_ENV=production esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.mts",
    "pack": "cross-env NODE_ENV=production run-p pack:zip pack:crx pack:xpi",
    "pack:zip": "node -e \"require('node:fs').rmSync('extension.zip', { force: true })\" && jszip-cli add extension/* -o ./extension.zip",
    "pack:crx": "crx3 extension -o ./extension.crx",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "clear": "esno scripts/clean.ts",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "simple-git-hooks",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/shared": "^14.3.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.21",
    "js-md5": "^0.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@ffflorian/jszip-cli": "^3.16.4",
    "@types/node": "^26.1.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/eslint-plugin": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "eslint": "^10.7.0",
    "esno": "^4.8.0",
    "jsdom": "^29.1.1",
    "lodash-imports": "^0.0.3",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "sass-embedded": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uno-colors": "^0.1.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-demi": "^0.14.10",
    "web-ext": "^10.5.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
